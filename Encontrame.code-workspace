{
  "folders": [
    {
      "name": "Front",
      "path": "."
    },
    {
      "name": "Back",
      "path": "../../backend/EncontrameApi"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/bin": true,
      "**/obj": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csharp",
      "ms-dotnettools.csdevkit",
      "expo.vscode-expo-tools"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Encontrame: API + App",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["start"],
        "cwd": "${workspaceFolder:Front}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
        "preLaunchTask": "Back: run-api",
        "skipFiles": ["<node_internals>/**"],
        "presentation": {
          "order": 1,
          "group": "encontrame"
        }
      },
      {
        "name": "Expo",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["start"],
        "cwd": "${workspaceFolder:Front}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
        "skipFiles": ["<node_internals>/**"]
      }
    ],
    "compounds": [
      {
        "name": "Encontrame: API + App (debug)",
        "configurations": [
          { "folder": "Back", "name": "API" },
          { "folder": "Front", "name": "Expo" }
        ],
        "stopAll": true,
        "presentation": {
          "order": 2,
          "group": "encontrame"
        }
      }
    ]
  }
}
