# Usa repositórios mockados quando "true" (padrão em dev, não depende da API).
# Defina "false" para falar com a EncontrameApi real.
EXPO_PUBLIC_USE_MOCKS=false

# URL base da API (usada quando EXPO_PUBLIC_USE_MOCKS=false).
# Emulador Android: http://10.0.2.2:5080 | device físico: http://<IP-da-máquina>:5080
EXPO_PUBLIC_API_URL=https://encontrameapi.onrender.com
