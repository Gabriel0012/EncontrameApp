# Usa repositórios mockados quando "true" (padrão em dev, não depende da API).
# Defina "false" para falar com a EncontrameApi real.
EXPO_PUBLIC_USE_MOCKS=false

# URL base da API já com /api (usada quando EXPO_PUBLIC_USE_MOCKS=false).
# Local: http://localhost:5080/api | Emulador Android: http://10.0.2.2:5080/api
# EXPO_PUBLIC_API_URL=https://encontrameapi.onrender.com/api
EXPO_PUBLIC_API_URL=https://localhost:44391/api
