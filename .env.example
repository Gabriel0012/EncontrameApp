# Usa repositórios mockados quando "true" (padrão em dev, não depende da API).
EXPO_PUBLIC_USE_MOCKS=true

# URL base da API existente (usada quando EXPO_PUBLIC_USE_MOCKS=false).
EXPO_PUBLIC_API_URL=

# API key do Google Maps (Maps SDK for Android) — build nativo (`npx expo run:android`).
# Não funciona no Expo Go (SDK 57). Crie em https://console.cloud.google.com/apis/credentials
# Habilite "Maps SDK for Android" e restrinja ao package com.anonymous.EncontrameApp + SHA-1 debug.
GOOGLE_MAPS_API_KEY=

# API key da Maps JavaScript API (web). Pública no bundle — restrinja a HTTP referrers
# (localhost e o domínio de produção). Não reutilize a chave restrita ao Android.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# Client ID web do OAuth 2.0 (Google Cloud → Credenciais). Público no bundle.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
