# Copie para .env.local e preencha (gitignored).
# Alternativa: defina as mesmas variáveis no ambiente da máquina (Windows / Netlify).
# O processo da máquina tem precedência sobre os arquivos.
# Reinicie o Metro / faça um novo deploy depois de mudar EXPO_PUBLIC_*.

# Usa repositórios mockados quando "true" (padrão em dev, não depende da API).
EXPO_PUBLIC_USE_MOCKS=true

# URL base da API já com /api (usada quando EXPO_PUBLIC_USE_MOCKS=false).
# Local: http://localhost:5080/api | Emulador Android: http://10.0.2.2:5080/api
# Produção: https://encontrameapi.onrender.com/api
EXPO_PUBLIC_API_URL=

# API key do Google Maps (Maps SDK for Android) — build nativo (`npx expo run:android`).
# Não funciona no Expo Go (SDK 57). Crie em https://console.cloud.google.com/apis/credentials
# Habilite "Maps SDK for Android" e restrinja ao package com.anonymous.EncontrameApp + SHA-1 debug.
# Não é necessária no deploy web (Netlify).
GOOGLE_MAPS_API_KEY=

# API key da Maps JavaScript API (web). Pública no bundle — restrinja a HTTP referrers
# (localhost e o domínio de produção, ex. https://seu-site.netlify.app/*).
# Não reutilize a chave restrita ao Android.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# Client ID web do OAuth 2.0 (Google Cloud → Credenciais). Público no bundle.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Chave fixa do app (header X-App-Key). Deve coincidir com AppKey:Value / AppKey__Value da API.
EXPO_PUBLIC_APP_KEY=
