{
  "expo": {
    "name": "EncontrameApp",
    "slug": "EncontrameApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "encontrameapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSFaceIDUsageDescription": "O Encontra-me usa a Face ID para entrar na sua conta neste celular.",
        "NSLocationWhenInUseUsageDescription": "O Encontra-me usa sua localização para mostrar onde você está no mapa."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2442",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.EncontrameApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/pages"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2442",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Encontra-me usa a Face ID para entrar na sua conta neste celular."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Encontra-me precisa acessar suas fotos para o cadastro.",
          "cameraPermission": "O Encontra-me precisa da câmera para fotografar a pessoa."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Encontra-me usa sua localização para mostrar onde você está no mapa."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
